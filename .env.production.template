# UNSTICKER 生产环境配置
# 复制此文件为 .env.production 并填入真实的密钥值

# ==================== OpenAI 配置 ====================
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-替换为你的OpenAI密钥
OPENAI_API_URL=https://api.openai.com/v1/images/edits

# ==================== 腾讯云配置 ====================
# 获取地址: https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=替换为你的SecretId
TENCENTCLOUD_SECRET_KEY=替换为你的SecretKey
TENCENTCLOUD_REGION=ap-guangzhou

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
PYTHON_BIN=python3

# ==================== 注意事项 ====================
# 1. 至少配置 OpenAI 或腾讯云其中一组密钥
# 2. 配置完成后，重命名此文件为 .env.production
# 3. 不要将包含真实密钥的文件提交到 Git
