[Unit]
Description=UNSTICKER Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/unsticker
EnvironmentFile=/opt/unsticker/.env.production
ExecStart=/usr/bin/python3 -m uvicorn app.server_production:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=10

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unsticker

# 安全限制
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
